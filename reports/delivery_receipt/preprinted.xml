<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="delivery_receipt_preprinted">

        <div class="page"
             style="
                position:relative;
                width:210mm;
                height:297mm;
                box-sizing:border-box;
                font-family:Arial, Helvetica, sans-serif;
                font-size:10px;
                line-height:1.25;
                color:#000;
             ">

            <!-- ========================================================= -->
            <!-- DATA                                                       -->
            <!-- ========================================================= -->

            <t t-set="p" t-value="docs[0]"/>
            <t t-set="partner" t-value="p.partner_id"/>


            <!-- ========================================================= -->
            <!-- DELIVERY RECEIPT NUMBER                                    -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:29mm;
                right:10mm;
                width:45mm;
                font-size:12px;
                font-weight:bold;
                white-space:nowrap;
                text-align:right;
            ">
                <span t-esc="p.name"/>
            </div>


            <!-- ========================================================= -->
            <!-- DELIVERED TO                                               -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:41mm;
                left:30mm;
                width:90mm;
                white-space:nowrap;
            ">
                <span t-esc="partner.name or ''"/>
            </div>


            <!-- ========================================================= -->
            <!-- TIN                                                        -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:48mm;
                left:30mm;
                width:70mm;
                white-space:nowrap;
            ">
                <span t-esc="partner.vat or ''"/>
            </div>


            <!-- ========================================================= -->
            <!-- ADDRESS                                                    -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:55mm;
                left:30mm;
                width:105mm;
            ">
                <span t-esc="partner.contact_address or ''"/>
            </div>


            <!-- ========================================================= -->
            <!-- DATE                                                       -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:41mm;
                left:164mm;
                width:35mm;
                white-space:nowrap;
            ">
                <span t-esc="p.date_done or p.scheduled_date"
                      t-options="{'widget':'date'}"/>
            </div>


            <!-- ========================================================= -->
            <!-- TERMS                                                      -->
            <!-- ========================================================= -->

            <div style="
                position:absolute;
                top:48mm;
                left:164mm;
                width:35mm;
                white-space:nowrap;
            ">
                <span t-esc="''"/>
            </div>


            <!-- ========================================================= -->
            <!-- ITEMS                                                      -->
            <!-- ========================================================= -->

            <t t-set="y" t-value="68"/>

            <t t-foreach="p.move_ids" t-as="line">

                <!-- QTY -->

                <div t-att-style="
                    'position:absolute;
                     top:%smm;
                     left:18mm;
                     width:20mm;
                     text-align:center;' % y
                ">
                    <span t-esc="
                        line.quantity or line.product_uom_qty
                    "/>
                </div>


                <!-- UNIT -->

                <div t-att-style="
                    'position:absolute;
                     top:%smm;
                     left:48mm;
                     width:20mm;
                     text-align:center;' % y
                ">
                    <span t-esc="line.product_uom.name"/>
                </div>


                <!-- DESCRIPTION -->

                <div t-att-style="
                    'position:absolute;
                     top:%smm;
                     left:70mm;
                     width:120mm;' % y
                ">
                    <span t-esc="line.product_id.display_name"/>
                </div>


                <t t-set="y" t-value="y + 7"/>

            </t>

        </div>

    </template>

</odoo>