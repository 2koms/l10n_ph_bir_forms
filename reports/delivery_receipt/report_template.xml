<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="delivery_receipt">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-if="print_type == 'preprinted'">

                    <t t-call="l10n_ph_bir_forms.delivery_receipt_preprinted">
                        <t t-set="p" t-value="o"/>
                    </t>

                </t>

                <t t-else="">

                    <t t-call="l10n_ph_bir_forms.delivery_receipt_computerized">
                        <t t-set="p" t-value="o"/>
                    </t>

                </t>

            </t>

        </t>

    </template>

</odoo>