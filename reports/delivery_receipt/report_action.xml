<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_delivery_receipt" model="report.paperformat">
        <field name="name">Delivery Receipt (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_delivery_receipt_report" model="ir.actions.report">
        <field name="name">Delivery Receipt</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ph_bir_forms.delivery_receipt</field>
        <field name="report_file">l10n_ph_bir_forms.delivery_receipt</field>
        <field name="paperformat_id" ref="l10n_ph_bir_forms.paperformat_delivery_receipt"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        
        <!-- THIS IS THE FIX: It evaluates 'OUT/00001' to '00001' -->
        <field name="print_report_name">'Delivery Receipt - %s' % (object.name.split('/')[-1] if object.name else 'Draft')</field>
        
    </record>

</odoo>