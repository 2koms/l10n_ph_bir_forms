<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="soa">

        <t t-call="web.external_layout">

            <div class="page">

                <h2 class="text-center">
                    Statement of Account
                </h2>

                <br/>

                <!-- ============================================== -->
                <!-- Header -->
                <!-- ============================================== -->

                <table class="table table-sm table-borderless">

                    <tr>
                        <td width="20%"><strong>Company</strong></td>
                        <td>
                            <span t-esc="company.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td><strong>Customer</strong></td>
                        <td>
                            <span t-esc="partner.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td><strong>Statement Date</strong></td>
                        <td>
                            <span t-esc="statement_date"/>
                        </td>
                    </tr>

                    <tr t-if="date_from">
                        <td><strong>Date From</strong></td>
                        <td>
                            <span t-esc="date_from"/>
                        </td>
                    </tr>

                    <tr>
                        <td><strong>Statement Type</strong></td>
                        <td>
                            <t t-if="statement_type == 'outstanding'">
                                Outstanding Statement
                            </t>
                            <t t-if="statement_type == 'full'">
                                Full Statement
                            </t>
                        </td>
                    </tr>

                </table>

                <br/>

                <!-- ============================================== -->
                <!-- Opening Balance -->
                <!-- ============================================== -->

                <table class="table table-sm table-bordered">

                    <tbody>

                        <tr>

                            <td colspan="5">
                                <strong>Opening Balance</strong>
                            </td>

                            <td class="text-end">
                                <strong>
                                    <span t-esc="'{:,.2f}'.format(opening_balance)"/>
                                </strong>
                            </td>

                        </tr>

                    </tbody>

                </table>

                <br/>

                <!-- ============================================== -->
                <!-- Transactions -->
                <!-- ============================================== -->

                <table class="table table-sm table-bordered">

                    <thead>

                        <tr>

                            <th>Date</th>

                            <th>Document</th>

                            <th>Reference</th>

                            <th>Description</th>

                            <th class="text-end">Debit</th>

                            <th class="text-end">Credit</th>

                            <th class="text-end">Balance</th>

                        </tr>

                    </thead>

                    <tbody>

                        <t t-if="lines">

                            <t t-foreach="lines" t-as="line">

                                <tr>

                                    <td>
                                        <span t-esc="line['date']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['document']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['reference']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['description']"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(line['debit'])"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(line['credit'])"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(line['balance'])"/>
                                    </td>

                                </tr>

                            </t>

                        </t>

                        <t t-if="not lines">

                            <tr>

                                <td colspan="7" class="text-center">

                                    No transactions found.

                                </td>

                            </tr>

                        </t>

                    </tbody>

                    <tfoot>

                        <tr>

                            <td colspan="4" class="text-end">

                                <strong>Total Debit</strong>

                            </td>

                            <td class="text-end">

                                <strong>
                                    <span t-esc="'{:,.2f}'.format(total_debit)"/>
                                </strong>

                            </td>

                            <td/>

                            <td/>

                        </tr>

                        <tr>

                            <td colspan="5" class="text-end">

                                <strong>Total Credit</strong>

                            </td>

                            <td class="text-end">

                                <strong>
                                    <span t-esc="'{:,.2f}'.format(total_credit)"/>
                                </strong>

                            </td>

                            <td/>

                        </tr>

                        <tr>

                            <td colspan="6" class="text-end">

                                <strong>Closing Balance</strong>

                            </td>

                            <td class="text-end">

                                <strong>
                                    <span t-esc="'{:,.2f}'.format(closing_balance)"/>
                                </strong>

                            </td>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </t>

    </template>

</odoo>
