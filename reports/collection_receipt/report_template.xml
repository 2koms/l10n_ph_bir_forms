<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="collection_receipt">

        <t t-call="web.html_container">

            <t t-if="data and data.get('print_type') == 'preprinted'">

                <t t-call="l10n_ph_bir_forms.collection_receipt_preprinted"/>

            </t>

            <t t-else="">

                <t t-call="l10n_ph_bir_forms.collection_receipt_computerized"/>

            </t>

        </t>

    </template>

</odoo>