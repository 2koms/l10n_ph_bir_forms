<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="collection_receipt_computerized">

        <t t-call="web.html_container">

            <t t-foreach="docs_data" t-as="d">

                <div class="page"
                     style="font-family:Arial, Helvetica, sans-serif;
                            font-size:10pt;
                            color:#000;
                            padding:15px;">

                    <!-- ================================================= -->
                    <!-- HEADER -->
                    <!-- ================================================= -->

                    <table style="width:100%; border-collapse:collapse; margin-bottom:18px;">

                        <tr>

                            <!-- LEFT SIDE -->
                            <td style="width:68%; vertical-align:top;">

                                <img t-if="d['company_logo']"
                                    t-att-src="image_data_uri(d['company_logo'])"
                                    style="max-height:60px; max-width:250px;"/>

                                <div style="
                                    font-size:15pt;
                                    font-weight:bold;
                                    text-transform:uppercase;
                                    margin-top:6px;">

                                    <span t-esc="d['company_name']"/>

                                </div>

                                <div style="margin-top:12px;">
                                    <span t-esc="d['company_address']"/>
                                </div>

                                <div>
                                    Tel No. :
                                    <span t-esc="d['company_phone']"/>
                                </div>

                                <div>
                                    Mobile No. :
                                    <span t-esc="d['company_mobile']"/>
                                </div>

                                <div>
                                    VAT Reg. TIN :
                                    <span t-esc="d['company_vat']"/>
                                </div>

                            </td>

                            <!-- RIGHT SIDE -->
                            <td style="width:32%; vertical-align:top;">

                                <div style="
                                    text-align:center;
                                    font-size:18pt;
                                    font-weight:bold;
                                    margin-top:6px;
                                    margin-bottom:55px;">

                                    COLLECTION RECEIPT

                                </div>

                                <table style="width:100%; border-collapse:collapse;">

                                    <tr>

                                        <td style="
                                            width:45px;
                                            text-align:right;
                                            font-weight:bold;">

                                            No.

                                        </td>

                                        <td style="padding-left:8px;">

                                            <span t-esc="d['receipt_no']"/>

                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="
                                            text-align:right;
                                            padding-top:14px;">

                                            Date:

                                        </td>

                                        <td style="
                                            padding-left:8px;
                                            padding-top:14px;">

                                            <span t-esc="d['receipt_date']"
                                                t-options="{'widget':'date'}"/>

                                        </td>

                                    </tr>

                                </table>

                            </td>

                        </tr>

                    </table>

                    <!-- ================================================= -->
                    <!-- BODY -->
                    <!-- ================================================= -->

                    <div style="margin-top:28px; font-size:10pt;">

                        <!-- Received From -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                            <tr>
                                <td style="width:140px; white-space:nowrap;">
                                    Received from
                                </td>

                                <td style="border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['customer_name']"/>
                                </td>

                                <td style="width:70px; padding-left:10px;">
                                    with TIN
                                </td>

                                <td style="width:420px; border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['customer_tin']"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Address -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                            <tr>
                                <td style="width:140px; white-space:nowrap;">
                                    and address at
                                </td>

                                <td style="border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['customer_address']"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Business Style -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                            <tr>
                                <td style="width:250px; white-space:nowrap;">
                                    engaged in the business style of
                                </td>

                                <td style="border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['customer_business_style']"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Amount in Words -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                            <tr>
                                <td style="width:80px;">
                                    the sum of
                                </td>

                                <td style="border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['amount_in_words']"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Amount / Payment Reference -->
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>

                                <td style="width:30px;">
                                    (₱)
                                </td>

                                <td style="width:90px; border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="'{:,.2f}'.format(d['amount'])"/>
                                </td>

                                <td style="width:190px; padding-left:10px;">
                                    in partial/full payment for
                                </td>

                                <td style="border-bottom:1px solid #000; padding-left:6px;">
                                    <span t-esc="d['payment_reference']"/>
                                </td>

                            </tr>
                        </table>

                    </div>
                    <!-- ================================================= -->
                    <!-- PAYMENT METHOD -->
                    <!-- ================================================= -->
                    <table style="
                        width:100%;
                        border-collapse:collapse;
                        margin-top:18px;
                        font-size:10pt;">

                        <tr>

                            <!-- LEFT SIDE -->
                            <td style="width:55%;">

                                ☐ Cash

                                <span style="
                                    display:inline-block;
                                    width:70px;
                                    border-bottom:1px solid #000;
                                    margin-left:8px;">
                                </span>

                                <br/>

                                ☐ Check

                                <span style="
                                    display:inline-block;
                                    width:70px;
                                    border-bottom:1px solid #000;
                                    margin-left:5px;">
                                </span>

                            </td>

                            <!-- RIGHT SIDE -->
                            <td style="text-align:right; white-space:nowrap;">

                                <span style="
                                    display:inline-block;
                                    width:18px;
                                    text-align:left;">
                                    ₱
                                </span>

                                <span style="
                                    display:inline-block;
                                    width:285px;
                                    border-bottom:1px solid #000;
                                    vertical-align:middle;">
                                </span>

                            </td>

                        </tr>

                    </table>


                    <table style="
                        width:60%;
                        margin-left:auto;
                        margin-top:25px;
                        border-collapse:collapse;
                        font-size:10pt;">

                        <tr>

                            <td style="width:65%;">
                                Total Amount Payable
                            </td>

                            <td style="
                                width:35%;
                                text-align:right;
                                border-bottom:1px solid #000;
                                padding-right:4px;">

                                <span t-esc="'{:,.2f}'.format(d['total_amount_payable'])"/>

                            </td>

                        </tr>

                        <tr>

                            <td>
                                Less Expanded Withholding Tax
                            </td>

                            <td style="
                                text-align:right;
                                border-bottom:1px solid #000;
                                padding-right:4px;">

                                <span t-esc="'{:,.2f}'.format(d['withholding_tax'])"/>

                            </td>

                        </tr>

                        <tr>

                            <td>
                                <strong>Collectible Amount</strong>
                            </td>

                            <td style="
                                text-align:right;
                                border-bottom:1px solid #000;
                                padding-right:4px;">

                                <strong>
                                    <span t-esc="'{:,.2f}'.format(d['collectible_amount'])"/>
                                </strong>

                            </td>

                        </tr>

                    </table>
                    <!-- ================================================= -->
                    <!-- SIGNATURE                                          -->
                    <!-- ================================================= -->

                    <div style="
                        margin-top:40px;
                        text-align:right;">

                        Thank You for your Remittance

                        <br/><br/><br/>

                        ______________________________________

                        <br/>

                        <i>Cashier / Authorized Representative</i>

                    </div>

                    <!-- ================================================= -->
                    <!-- PAYMENT DISTRIBUTION                              -->
                    <!-- ================================================= -->

                    <table style="
                        width:100%;
                        margin-top:45px;
                        border-collapse:collapse;
                        border:1px solid #000;
                        font-family:Arial, Helvetica, sans-serif;
                        font-size:10pt;">

                        <!-- Title -->
                        <tr>
                            <th colspan="4"
                                style="
                                    border:1px solid #000;
                                    padding:6px;
                                    text-align:center;
                                    font-size:12pt;
                                    font-weight:bold;">
                                PAYMENT DISTRIBUTION
                            </th>
                        </tr>

                        <!-- Column Headers -->
                        <tr style="height:28px;">

                            <th style="
                                width:35%;
                                border:1px solid #000;
                                text-align:center;">
                                INVOICE #
                            </th>

                            <th style="
                                width:20%;
                                border:1px solid #000;
                                text-align:center;">
                                DATE
                            </th>

                            <th style="
                                width:25%;
                                border:1px solid #000;
                                text-align:center;">
                                AMOUNT
                            </th>

                            <th style="
                                width:20%;
                                border:1px solid #000;
                                text-align:center;">
                                W/TAX
                            </th>

                        </tr>

                        <!-- Dynamic Invoice Lines -->
                        <t t-foreach="d['invoice_lines']" t-as="line">

                            <tr style="height:28px;">

                                <td style="
                                    border:1px solid #000;
                                    padding-left:6px;">

                                    <span t-esc="line['invoice_no']"/>

                                </td>

                                <td style="
                                    border:1px solid #000;
                                    text-align:center;">

                                    <span t-esc="line['invoice_date']"
                                        t-options="{'widget':'date'}"/>

                                </td>

                                <td style="
                                    border:1px solid #000;
                                    text-align:right;
                                    padding-right:6px;">

                                    <span t-esc="'{:,.2f}'.format(line['amount'])"/>

                                </td>

                                <td style="
                                    border:1px solid #000;
                                    text-align:right;
                                    padding-right:6px;">

                                    <span t-esc="line['withholding_tax']"/>

                                </td>

                            </tr>

                        </t>

                        <!-- Blank Rows -->
                        <t t-set="blank_rows" t-value="max(0, 10 - len(d['invoice_lines']))"/>

                        <t t-foreach="range(blank_rows)" t-as="i">

                            <tr style="height:28px;">

                                <td style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;"></td>

                            </tr>

                        </t>

                        <!-- TOTAL -->
                        <tr style="height:30px;">

                            <td colspan="2"
                                style="
                                    border:1px solid #000;
                                    text-align:center;
                                    font-weight:bold;">
                                TOTAL
                            </td>

                            <td style="
                                border:1px solid #000;
                                text-align:right;
                                padding-right:6px;
                                font-weight:bold;">

                                <span t-esc="'{:,.2f}'.format(d['total_amount_payable'])"/>

                            </td>

                            <td style="
                                border:1px solid #000;
                                text-align:right;
                                padding-right:6px;">

                                <span t-esc="d['withholding_tax']"/>

                            </td>

                        </tr>

                    </table>

                    <!-- ================================================= -->
                    <!-- FOOTNOTE                                          -->
                    <!-- ================================================= -->

                    <div style="
                        margin-top:45px;
                        width:100%;
                        text-align:center;
                        font-size:9pt;
                        font-style:italic;">

                        "THIS DOCUMENT IS NOT VALID FOR CLAIMING INPUT TAXES"

                    </div>

                </div>

            </t>

        </t>

    </template>

</odoo>