<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         COLLECTION RECEIPT REPORT
         ========================================================== -->

    <record id="action_collection_receipt_report" model="ir.actions.report">

        <field name="name">Collection Receipt</field>

        <field name="model">account.payment</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">l10n_ph_bir_forms.collection_receipt</field>

        <field name="report_file">l10n_ph_bir_forms.collection_receipt</field>

        <!-- Reuse the same paper format -->
        <field name="paperformat_id"
               ref="l10n_ph_bir_forms.paperformat_sales_invoice"/>

        <!-- Show in Print menu of Customer Payments -->
        <field name="binding_model_id"
               ref="account.model_account_payment"/>

        <field name="binding_type">report</field>

        <field name="print_report_name">'Collection Receipt - %s' % (object.name)</field>

    </record>

</odoo>