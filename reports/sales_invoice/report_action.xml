<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         PAPER FORMAT
         ========================================================== -->

    <record id="paperformat_sales_invoice" model="report.paperformat">

        <field name="name">Sales Invoice (Letter)</field>

        <field name="default" eval="False"/>

        <field name="format">Letter</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>


    <!-- ==========================================================
         SALES INVOICE REPORT
         ========================================================== -->

    <record id="action_sales_invoice_report" model="ir.actions.report">

        <field name="name">Sales Invoice</field>

        <field name="model">account.move</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">l10n_ph_bir_forms.sales_invoice</field>

        <field name="report_file">l10n_ph_bir_forms.sales_invoice</field>

        <field name="paperformat_id" ref="paperformat_sales_invoice"/>

        <field name="binding_model_id" ref="account.model_account_move"/>

        <field name="binding_type">report</field>

        <field name="print_report_name">'Sales Invoice - %s' % (object.name)</field>

    </record>

</odoo>