<odoo>
    <template id="sales_invoice_computerized">

        <t t-call="web.basic_layout">

            <t t-foreach="docs_data" t-as="d">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 9.5px; color:#000;">

                    <!-- ===================== HEADER ===================== -->
                     <table style="width:100%;border-collapse:collapse;border:1px solid #000;">
                        <tr>

                            <!-- COMPANY -->
                            <td style="width:65%;vertical-align:top;padding:8px;border-right:1px solid #000;">

                                <img t-if="d['company'].logo"
                                     t-att-src="image_data_uri(d['company'].logo)"
                                     style="max-height:60px;max-width:220px;"/>

                                <div style="font-size:16px;font-weight:bold;margin-top:4px;">
                                    <span t-esc="d['company'].name"/>
                                </div>

                                <div>
                                    <span t-esc="d['company_address']"/>
                                </div>

                                <div>
                                    Tel No. :
                                    <span t-esc="d['company'].phone"/>
                                </div>

                                <div>
                                    Mobile No. :
                                    <span t-esc="d['company_mobile']"/>
                                </div>

                                <div>
                                    VAT REG. TIN :
                                    <span t-esc="d['company'].vat"/>
                                </div>

                            </td>

                            <!-- DOCUMENT INFO -->
                            <td style="width:35%;vertical-align:top;padding:12px;">

                                <div style="text-align:right;">

                                    <div style="font-size:26px;font-weight:bold;">
                                        INVOICE
                                    </div>

                                    <div style="margin-top:35px; text-align:right;">
                                        <div style="font-size:11px; color:#555;">
                                            Invoice No.
                                        </div>

                                        <div style="font-size:16px; font-weight:bold;">
                                            <t t-esc="d['invoice'].name"/>
                                        </div>
                                    </div>
                                </div>

                            </td>

                        </tr>
                    </table>

                    <hr style="border-top:1px solid #000;margin:4px 0;"/>

                    <!-- ===================== CUSTOMER / INVOICE INFO ===================== -->
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="width:55%; vertical-align:top; padding:1px 4px;">
                                <div>CUSTOMER NAME : <span t-esc="d['customer_name']"/></div>
                                <div>TIN: <span t-esc="d['tin_no']"/></div>
                                <div>
                                    ADDRESS:
                                    <t t-foreach="d['addr_lines']" t-as="addr_line">
                                        <span t-esc="addr_line"/><t t-if="not addr_line_last">, </t>
                                    </t>
                                </div>
                                <div>OSCA/PWD ID NO:</div>
                                <div>Cardholder's Signature:</div>
                                <div>P.R. No.:</div>
                                <div>
                                    MAKE: <span t-esc="d['make']"/>
                                     MODEL: <span t-esc="d['model']"/>
                                    RENTAL NO.: <span t-esc="d['rental_no']"/>
                                    SERIAL No.: <span t-esc="d['serial_no']"/>
                                </div>
                            </td>
                            <td style="width:45%; vertical-align:top; padding:1px 4px;">
                                <div>DATE: <span t-esc="d['invoice_date']" t-options="{'widget': 'date'}"/></div>
                                <div>PO No.: <span t-esc="d['customer_po']"/></div>
                                <div>CONTACT No.: <span t-esc="d['contact_no']"/></div>
                                <div>TERMS: <span t-esc="d['term']"/></div>
                                <div>P.M. Contract:  ( ) YES  ( ) NO</div>
                                <div>Requisition No.:</div>
                            </td>
                        </tr>
                    </table>

                    <!-- ===================== LINE ITEMS ===================== -->
                    <table style="width:100%; border-collapse:collapse; margin-top:4px; border:1px solid #000;">
                        <thead>
                            <tr style="border-bottom:1px solid #000;">
                                <th style="text-align:center; width:8%; padding:3px;">QTY</th>
                                <th style="text-align:center; width:14%; padding:3px;">PART NO.</th>
                                <th style="text-align:center; width:10%; padding:3px;">UNIT</th>
                                <th style="text-align:left; width:38%; padding:3px;">PARTICULARS</th>
                                <th style="text-align:right; width:15%; padding:3px;">UNIT COST</th>
                                <th style="text-align:right; width:15%; padding:3px;">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d['lines']" t-as="l">
                                <td style="text-align:center; padding:2px;"><span t-esc="l['qty']"/></td>
                                <td style="text-align:center; padding:2px;"><span t-esc="l['part_no']"/></td>
                                <td style="text-align:center; padding:2px;"><span t-esc="l['uom']"/></td>
                                <td style="text-align:left; padding:2px;"><span t-esc="l['particulars']"/></td>
                                <td style="text-align:right; padding:2px;">
                                    <span t-esc="l['unit_cost']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td style="text-align:right; padding:2px;">
                                    <span t-esc="l['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                            </tr>
                            
                            <tr>
                                <td colspan="6" style="padding:4px; font-weight:bold;">
                                    Period Covered:
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ===================== TOTAL IN WORDS + SUMMARY / TOTALS
                         (merged into ONE bordered box, continuing directly
                         under the line-items table above, no gap) ===================== -->
                    <table style="width:100%; border-collapse:collapse; border:1px solid #000; border-top:none;">
                        <tr>
                            <td colspan="3" style="border-bottom:1px solid #000; padding:3px;">
                                TOTAL (in words)  <span t-esc="d['total_in_words']"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:25%; vertical-align:top; border-right:1px solid #000; padding:3px;">
                                <div style="text-align:center; font-weight:bold;">SUMMARY OF CHARGES</div>
                                <div>TOTAL MATERIALS
                                    <span style="float:right;" t-esc="d['total_materials']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>TOTAL LABOR
                                    <span style="float:right;" t-esc="d['total_labor']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <br/>
                                <div>TAX
                                    <span style="float:right;" t-esc="d['tax']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div style="font-weight:bold;">TOTAL AMOUNT
                                    <span style="float:right;" t-esc="d['total_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                            </td>
                            <td style="width:35%; vertical-align:top; border-right:1px solid #000; padding:3px;">
                                <div>VATable Sales
                                    <span style="float:right;" t-esc="d['vatable_sales']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>VAT
                                    <span style="float:right;" t-esc="d['vat_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Zero-Rated Sales
                                    <span style="float:right;" t-esc="d['vat_zero_rated_sales']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>VAT Exempt Sales
                                    <span style="float:right;" t-esc="d['vat_exempt_sales']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div style="border-top:1px solid #000; margin-top:14px; padding-top:14px;">
                                    Authorized Person Signature
                                </div>
                                <div>Approved by:</div>
                            </td>
                            <td style="width:40%; vertical-align:top; padding:3px;">
                                <div>Total Sales (VAT Inclusive)
                                    <span style="float:right;" t-esc="d['total_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Less: VAT
                                    <span style="float:right;" t-esc="d['vat_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Amount: Net Of VAT
                                    <span style="float:right;" t-esc="d['net_sales']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Less: Discount
                                    <span style="float:right;" t-esc="d['discount_total']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Add: VAT
                                    <span style="float:right;" t-esc="d['vat_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div>Less: Withholding Tax
                                    <span style="float:right;" t-esc="d['withholding_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div style="font-weight:bold; border-top:1px solid #000;">TOTAL AMOUNT DUE
                                    <span style="float:right;" t-esc="d['total_amount_due']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- ===================== TERMS (also boxed, continuing the frame) ===================== -->
                    <table style="width:100%; border-collapse:collapse; border:1px solid #000; border-top:none; font-size:8px;">
                        <tr>
                            <td style="width:50%; vertical-align:top; padding:3px;">
                                <div style="font-weight:bold;">For Repair Orders:</div>
                                <div>
                                    I hereby authorize the above repair work to be done along with the necessary
                                    materials and hereby grant you and your employees permission to operate the
                                    vehicle herein described on streets, highways or elsewhere for the purpose of
                                    testing and/or inspection. An expressed mechanic's lien is hereby acknowledged
                                    on above vehicle to secure the amount of repairs thereto.
                                </div>
                                <br/>
                                <div>
                                    The company is not responsible for loss or damage to vehicle or articles left
                                    in vehicles in case of fire, theft or any other case beyond our control.
                                    Storage will be charged commencing 48 hours after repairs are completed.
                                </div>
                                <br/>
                                <div>
                                    Company's responsibilities cease with the delivery of goods to public carriers
                                    in good order. This account is due and payable upon completion of the repair
                                    work authorized unless otherwise expressly agreed to in which case is due and
                                    payable within the first 10 days of the month following the date thereof.
                                    Authorized and all conditions and terms agreed to as stated on this Invoice.
                                </div>
                            </td>
                            <td style="width:50%; vertical-align:top; padding:3px; border-left:1px solid #000;">
                                <div style="font-weight:bold;">For all transaction:</div>
                                <div>
                                    Interest based on current prevailing rates shall be charged on all overdue
                                    accounts, and in the event of judicial proceedings to enforce collections,
                                    customer shall pay the Company the total amount due and an amount equivalent
                                    to not less than 25% of the amount due for attorney's fees, in addition to
                                    cost of suit. The parties voluntarily submit to the jurisdiction of the
                                    proper Court in the City of <span t-esc="d['company'].city"/> in case of
                                    litigation.
                                </div>
                                <br/>
                                <div style="border-top:1px solid #000; margin-top:20px; padding-top:2px;">
                                    Received the above item/s and/or services in good order and/or condition.
                                </div>
                                <div style="margin-top:16px;">Customer Printed Name and Signature</div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>
</odoo>