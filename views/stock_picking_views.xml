<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_bir_delivery_receipt"
            model="ir.ui.view">

        <field name="name">
            stock.picking.form.bir.delivery.receipt
        </field>

        <field name="model">stock.picking</field>

        <field name="inherit_id"
               ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//button[@name='%(stock.action_report_delivery)d']"
                   position="replace">

                <button name="%(l10n_ph_bir_forms.action_delivery_receipt_report)d"
                        string="Print"
                        type="action"
                        groups="base.group_user"
                        data-hotkey="o"
                        invisible="state != 'done'"
                        icon="fa-print"/>

            </xpath>

        </field>

    </record>

</odoo>