<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Statement of Account Wizard                           -->
    <!-- ===================================================== -->

    <record id="view_statement_of_account_wizard_form"
            model="ir.ui.view">

        <field name="name">statement.of.account.wizard.form</field>
        <field name="model">statement.of.account.wizard</field>

        <field name="arch" type="xml">

            <form string="Statement of Account">

                <sheet>

                    <!-- ========================================= -->
                    <!-- Customer                                  -->
                    <!-- ========================================= -->

                    <group string="Customer">

                        <field name="partner_id"/>

                    </group>

                    <!-- ========================================= -->
                    <!-- Statement Period                          -->
                    <!-- ========================================= -->

                    <group string="Statement Period" col="2">

                        <field name="date_from"/>

                        <field name="statement_date"/>

                    </group>

                    <!-- ========================================= -->
                    <!-- Report Options                            -->
                    <!-- ========================================= -->

                    <group string="Report Options">

                        <field
                            name="statement_type"
                            widget="radio"/>

                        <field name="include_credit_notes"/>

                        <field
                            name="print_header"
                            widget="radio"/>

                    </group>

                </sheet>

                <!-- ============================================= -->
                <!-- Footer                                        -->
                <!-- ============================================= -->

                <footer>

                    <button
                        name="action_print"
                        type="object"
                        string="Print Statement"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

    <!-- ===================================================== -->
    <!-- Window Action                                         -->
    <!-- ===================================================== -->

    <record id="action_statement_of_account_wizard"
            model="ir.actions.act_window">

        <field name="name">Statement of Account</field>

        <field name="res_model">statement.of.account.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>

</odoo>